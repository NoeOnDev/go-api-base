# Copiá este archivo a .env y completá los valores.
# El Makefile carga .env automáticamente en desarrollo.
# En producción, definí estas variables en el entorno (por ejemplo, en el servicio de systemd).

# development | production (production usa logs en JSON)
APP_ENV=development

# Dirección donde escucha el servidor HTTP
HTTP_ADDR=:8080

# Conexión a PostgreSQL (obligatoria)
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/go_api_base?sslmode=disable

# Base de datos para los tests de integración (opcional: si está vacía, esos tests se saltean).
# Debe ser una base distinta, cuyo nombre termine en "_test": los tests vacían todas sus tablas.
TEST_DATABASE_URL=postgres://usuario:contraseña@localhost:5432/go_api_base_test?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# Tiempo máximo para terminar las peticiones en curso al apagar el servidor
SHUTDOWN_TIMEOUT=10s

# Duración de la sesión desde el login
SESSION_TTL=168h

# La cookie de sesión solo viaja por HTTPS. Por defecto: true en producción, false en desarrollo.
# COOKIE_SECURE=true

# Orígenes del frontend si está en otro dominio, separados por comas (vacío = sin CORS)
# Ejemplo: CORS_ALLOWED_ORIGINS=https://app.cliente.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# true si hay un proxy (Caddy, Nginx) delante: la IP real del cliente se lee de X-Forwarded-For
TRUST_PROXY=false

# URL del frontend: los correos llevan enlaces a sus pantallas (/reset-password, /verify-email)
FRONTEND_URL=http://localhost:5173

# true exige que el usuario verifique su email para usar las rutas protegidas
REQUIRE_EMAIL_VERIFICATION=false

# Envío de correos: log (los escribe en el log, para desarrollo) o smtp
MAIL_DRIVER=log
# Remitente. También acepta nombre, como Mi App <no-reply@miapp.com>, pero entonces el archivo
# no se puede cargar con "source" desde la shell (make y systemd lo leen bien).
MAIL_FROM=no-reply@localhost

# SMTP (con MAIL_DRIVER=smtp). Con Mailpit en desarrollo: SMTP_HOST=localhost y SMTP_PORT=1025, sin usuario.
# En producción, los datos SMTP de tu proveedor (Resend, Brevo, Amazon SES, Mailgun…), normalmente puerto 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
