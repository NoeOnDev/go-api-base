# Copy this file to .env and fill in the values.
# The Makefile loads .env automatically in development.
# In production, set these variables in the server's environment, not in a .env.

# development | production (production uses JSON logs)
APP_ENV=development

# Address the HTTP server listens on
HTTP_ADDR=:8080

# PostgreSQL connection (required)
DATABASE_URL=postgres://user:password@localhost:5432/go_api_base?sslmode=disable

# Database for the integration tests (optional: if it is empty, those tests are skipped).
# It must be a different database, whose name ends in "_test": the tests empty all its tables.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/go_api_base_test?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# Maximum time to finish the running requests when the server shuts down
SHUTDOWN_TIMEOUT=10s

# Session lifetime from the login
SESSION_TTL=168h

# Optional: closes a session without activity for that long (at least 15m). 0 = off.
# SESSION_IDLE_TIMEOUT=30m

# The session cookie only travels over HTTPS. Default: true in production, false in development.
# COOKIE_SECURE=true

# Frontend origins if it is on another domain, separated by commas (empty = no CORS)
# Example: CORS_ALLOWED_ORIGINS=https://app.client.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# true if there is a proxy in front: the client's real IP is read from X-Forwarded-For.
# It is only trusted if the connection comes from localhost or a private network (where the proxy
# usually is). Even so, the API port must not be open to the internet: with the proxy on the same
# server, HTTP_ADDR=127.0.0.1:8080.
TRUST_PROXY=false

# With TRUST_PROXY=true: the exact IPs or CIDR ranges of the proxy, separated by commas. Empty, it
# trusts localhost and every private network. Better to set it if the proxy is on the same server,
# and required if your provider has a private network shared between customers.
# With a CDN in front of the proxy, add the CDN ranges too: the client's IP is the first one in
# X-Forwarded-For, from right to left, that is not from a proxy in this list. See "Before
# production" in the README.
# TRUSTED_PROXIES=127.0.0.1

# Frontend URL: the emails carry links to its screens (/reset-password, /verify-email)
FRONTEND_URL=http://localhost:5173

# true requires users to verify their email to use the protected routes
REQUIRE_EMAIL_VERIFICATION=false

# Email sending: log (writes them to the log, for development) or smtp
MAIL_DRIVER=log
# Sender. With a name, in quotes: MAIL_FROM="My App <no-reply@myapp.com>"
MAIL_FROM=no-reply@localhost

# SMTP (with MAIL_DRIVER=smtp). With Mailpit in development: SMTP_HOST=localhost and SMTP_PORT=1025, no user.
# In production, your provider's SMTP details (Resend, Brevo, Amazon SES, Mailgun…), usually port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional, only for the tests: with a test SMTP server (Mailpit), make test also tests real sending.
# SMTP_TEST_ADDR=localhost:1025

# Background jobs that run at once in the default queue (emails have their own queue of 4).
# If you raise it, raise the connection pool in DATABASE_URL too (?pool_max_conns=…; 10 if not set).
JOBS_MAX_WORKERS=10

# Application name (the one the authenticator app shows for the 2FA)
# Values with spaces go in quotes.
APP_NAME="My App"

# Language of the texts for the user (errors, emails, notifications) when the browser does not ask
# for an available one. The languages are the catalogs in internal/i18n/locales (see docs/i18n.md).
DEFAULT_LOCALE=en

# Key to encrypt sensitive data in the database, like the 2FA secret. Required.
# Generate it with: make key
# Keep it like any production secret: if it is lost, users will have to set up 2FA again.
ENCRYPTION_KEY=

# Previous keys, separated by commas: only during a rotation (see docs/encryption.md).
ENCRYPTION_PREVIOUS_KEYS=

# Optional. Go itself reads it, not the template: the garbage collector frees memory before
# reaching this value. In production, around 70% of the server's RAM is a good choice (with 1 GB: 700MiB).
# GOMEMLIMIT=700MiB
