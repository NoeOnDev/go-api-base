# Copiá este archivo a .env y completá los valores.
# El Makefile carga .env automáticamente en desarrollo.
# En producción, definí estas variables en el entorno (por ejemplo, en el servicio de systemd).

# development | production (production usa logs en JSON)
APP_ENV=development

# Dirección donde escucha el servidor HTTP
HTTP_ADDR=:8080

# Conexión a PostgreSQL (obligatoria)
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/go_api_base?sslmode=disable

# Base de datos para los tests de integración (opcional: si está vacía, esos tests se saltean).
# Debe ser una base distinta, cuyo nombre termine en "_test": los tests vacían todas sus tablas.
TEST_DATABASE_URL=postgres://usuario:contraseña@localhost:5432/go_api_base_test?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# Tiempo máximo para terminar las peticiones en curso al apagar el servidor
SHUTDOWN_TIMEOUT=10s

# Duración de la sesión desde el login
SESSION_TTL=168h

# Opcional: cierra una sesión sin actividad durante ese tiempo (al menos 15m). 0 = desactivado.
# SESSION_IDLE_TIMEOUT=30m

# La cookie de sesión solo viaja por HTTPS. Por defecto: true en producción, false en desarrollo.
# COOKIE_SECURE=true

# Orígenes del frontend si está en otro dominio, separados por comas (vacío = sin CORS)
# Ejemplo: CORS_ALLOWED_ORIGINS=https://app.cliente.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# true si hay un proxy (Caddy, Nginx) delante: la IP real del cliente se lee de X-Forwarded-For.
# Solo se cree si la conexión viene de localhost o de una red privada (el proxy en el mismo servidor
# o en Docker). Igual, el puerto de la API no debe quedar abierto a internet:
#   - con el proxy en el mismo servidor: HTTP_ADDR=127.0.0.1:8080;
#   - con Docker: no publiques el puerto, o publicalo solo en localhost (-p 127.0.0.1:8080:8080).
#     Si no, a veces las conexiones de afuera llegan con la IP privada del gateway de Docker.
TRUST_PROXY=false

# Con TRUST_PROXY=true: las IPs o rangos CIDR exactos del proxy, separados por comas. Vacío, se confía
# en localhost y en toda red privada. Conviene indicarlo si el proxy está en el mismo servidor, y es
# necesario si tu proveedor tiene una red privada compartida entre clientes.
# Con un CDN delante del proxy (Cloudflare → Caddy), sumá también los rangos del CDN
# (https://www.cloudflare.com/ips/): la IP del cliente es la primera de X-Forwarded-For, de derecha
# a izquierda, que no es de un proxy de esta lista. Ver "Antes de producción" en el README.
# TRUSTED_PROXIES=127.0.0.1

# URL del frontend: los correos llevan enlaces a sus pantallas (/reset-password, /verify-email)
FRONTEND_URL=http://localhost:5173

# true exige que el usuario verifique su email para usar las rutas protegidas
REQUIRE_EMAIL_VERIFICATION=false

# Envío de correos: log (los escribe en el log, para desarrollo) o smtp
MAIL_DRIVER=log
# Remitente. Con nombre, entre comillas: MAIL_FROM="Mi App <no-reply@miapp.com>"
MAIL_FROM=no-reply@localhost

# SMTP (con MAIL_DRIVER=smtp). Con Mailpit en desarrollo: SMTP_HOST=localhost y SMTP_PORT=1025, sin usuario.
# En producción, los datos SMTP de tu proveedor (Resend, Brevo, Amazon SES, Mailgun…), normalmente puerto 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Opcional, solo para los tests: con un SMTP de prueba (Mailpit), make test también prueba el envío real.
# SMTP_TEST_ADDR=localhost:1025

# Trabajos en segundo plano que corren a la vez en la cola default (los correos tienen su propia cola de 4).
# Si lo subís, subí también el pool de conexiones en DATABASE_URL (?pool_max_conns=…; 10 si no se indica).
JOBS_MAX_WORKERS=10

# Nombre de la aplicación (es el que muestra la app de autenticación del 2FA)
# Los valores con espacios van entre comillas.
APP_NAME="Mi App"

# Clave para cifrar datos sensibles en la base, como el secreto del 2FA. Obligatoria.
# Generala con: make key
# Guardala como cualquier secreto de producción: si se pierde, los usuarios tendrán que volver a configurar el 2FA.
ENCRYPTION_KEY=

# Claves anteriores, separadas por comas: solo durante una rotación (ver docs/encryption.md).
ENCRYPTION_PREVIOUS_KEYS=

# Opcional. La lee el propio Go, no la plantilla: el recolector de basura libera memoria antes de
# llegar a este valor. En producción conviene cerca del 70 % de la RAM del servidor (con 1 GB: 700MiB).
# GOMEMLIMIT=700MiB
