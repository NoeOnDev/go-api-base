# The configuration of the server (see docs/deploy.md). Copy it to .env, next to compose.yaml, and
# fill it in. That file has the secrets: it is not in git, and it is worth a backup apart from the
# server.
#
# compose.yaml already sets APP_ENV, HTTP_ADDR, DATABASE_URL, TRUST_PROXY and STORAGE_DIR.
# The rest of the variables of the API (the README lists them) can be added here.

# The domain, which must already point to this server. Caddy gets its certificate.
SITE_ADDRESS=example.com

# Only to try it on a machine where ports 80 and 443 are taken: the ones Caddy is published on.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# The password of the database. Only letters and numbers: it goes inside a URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The key that encrypts the 2FA secrets and the queued emails. If it is lost, the users set up 2FA
# again: keep a copy apart from the server.
#   docker compose run --rm --no-deps api generate-key
ENCRYPTION_KEY=

# The name of the application: the emails carry it, and the 2FA app shows it.
APP_NAME="My App"

# Where the links of the emails point: the address of the frontend.
FRONTEND_URL=https://example.com

# Only with the frontend on another domain than the API (see the Caddyfile).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# The emails, with the SMTP details of your provider (Resend, Brevo, Amazon SES, Mailgun…).
MAIL_DRIVER=smtp
MAIL_FROM="My App <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# An administrator account is the most valuable one to steal: ask them for 2FA.
REQUIRE_ADMIN_TWO_FACTOR=true

# The zone of the dates the API writes for people. For a system used in a single place, its zone.
APP_TIME_ZONE=UTC

# The uploaded files are kept in a volume of this server (STORAGE_DRIVER=local). For a bucket
# instead, which several servers can share and is backed up apart (see docs/files.md):
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
